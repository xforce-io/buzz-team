#!/bin/bash
# ~/lab/buzz/bin/buzz (issue #58): signature gate, then exec the official Buzz CLI.
# No buzz-team release, no python. Refuses (sends nothing) unless the binary passes
# `codesign --verify --strict`, is signed by TeamIdentifier EYF346PHUG and has Identifier buzz.
# BUZZ58_TEST_OFFICIAL_BUZZ is a test-only override of the binary path; the check still applies.
set -u
official="${BUZZ58_TEST_OFFICIAL_BUZZ:-/Applications/Buzz.app/Contents/MacOS/buzz}"
refuse() { echo "bin/buzz: refused, nothing sent: $official: $1" >&2; exit 3; }
[ -x /usr/bin/codesign ] || refuse "/usr/bin/codesign not available"
[ -f "$official" ] && [ -x "$official" ] || refuse "official binary missing or not executable"
/usr/bin/codesign --verify --strict "$official" 2>/dev/null || refuse "codesign --verify --strict failed"
info=$(/usr/bin/codesign -dv "$official" 2>&1) || refuse "codesign -dv failed"
team=$(printf '%s\n' "$info" | sed -n 's/^TeamIdentifier=//p')
ident=$(printf '%s\n' "$info" | sed -n 's/^Identifier=//p')
[ "$team" = "EYF346PHUG" ] || refuse "TeamIdentifier '${team:-none}' is not EYF346PHUG"
[ "$ident" = "buzz" ] || refuse "Identifier '${ident:-none}' is not buzz"
exec "$official" "$@"
