+//! Conservative per-turn evidence that a prompt may have reached the agent.
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    Arc,
+};
+
+/// Shared with panic recovery; cleanup must never erase an attempted delivery.
+#[derive(Clone, Default)]
+pub(crate) struct PromptDelivery(Arc<AtomicBool>);
+
+impl PromptDelivery {
+    pub(crate) fn mark_attempted(&self) {
+        self.0.store(true, Ordering::Release);
+    }
+
+    pub(crate) fn may_have_executed(&self) -> bool {
+        self.0.load(Ordering::Acquire)
+    }
+}
